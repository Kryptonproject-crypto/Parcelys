<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Position : indispensable au relevé de contour de parcelle. La position
      fine (GPS) est demandée explicitement — la position réseau, précise à
      quelques centaines de mètres, ne permet pas de tracer une limite de
      champ. Aucune permission d'arrière-plan n'est demandée : le relevé
      n'a lieu que l'écran allumé, application ouverte.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- État du réseau : sert à basculer en mode hors ligne sans attendre
         l'échec d'une requête. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Le GPS est requis : sans lui, l'usage principal de l'application est
         impossible. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />
</manifest>
