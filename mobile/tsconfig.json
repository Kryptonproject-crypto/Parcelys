{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@partage/*": ["../src/lib/ephy/*"],
      "@commun/*": ["../src/lib/shared/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "capacitor.config.ts",
    "../src/lib/ephy/dose.ts",
    "../src/lib/ephy/schema.ts",
    "../src/lib/ephy/conditions.ts",
    "../src/lib/ephy/catalogue-local.ts",
    "../src/lib/shared/sync-status.ts",
    "../src/lib/shared/geometrie.ts"
  ]
}
