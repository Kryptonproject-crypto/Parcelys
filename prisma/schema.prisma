  longitude        Float
  temperatureC     Decimal? @map("temperature_c") @db.Decimal(5, 1)
  humidity         Decimal? @db.Decimal(5, 1)
  windKmh          Decimal? @map("wind_kmh") @db.Decimal(5, 1)
  windDirectionDeg Int?     @map("wind_direction_deg")
  precipitationMm  Decimal? @map("precipitation_mm") @db.Decimal(6, 2)
  pressureHpa      Decimal? @map("pressure_hpa") @db.Decimal(7, 1)
  summary          String?
  provider         String
  createdAt        DateTime @default(now()) @map("created_at")

  farm   Farm?   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  parcel Parcel? @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([farmId, recordedAt])
  @@index([parcelId, recordedAt])
  @@map("weather_records")
}

model Document {
  id           String   @id @default(cuid())
  farmId       String   @map("farm_id")
  parcelId     String?  @map("parcel_id")
  fileName     String   @map("file_name")
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  checksum     String?
  category     String   @default("AUTRE")
  description  String?
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  farm       Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  parcel     Parcel? @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  deviations   NitrogenPlanDeviation[]
  soilAnalyses SoilAnalysis[]

  @@index([farmId])
  @@index([parcelId])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(cuid())
  farmId    String?  @map("farm_id")
