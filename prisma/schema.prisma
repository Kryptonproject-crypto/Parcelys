// ---------------------------------------------------------------------------
// PAC / TéléPAC
//
// Ce module s'ajoute au modèle existant sans le remplacer. Les parcelles
// restent dans `parcels`, leurs géométries dans `parcel_geometries`, et les
// campagnes culturales dans `crop_years` : un import PAC alimente ces tables
// comme le ferait une saisie manuelle. Les tables ci-dessous ne conservent que
// ce que le modèle actuel ne sait pas exprimer — l'îlot, les SNA et ZDH, la
// provenance des données, et ce qui a changé depuis l'import.
// ---------------------------------------------------------------------------

enum PacFeatureKind {
  /// Parcelle culturale déclarée.
  PARCELLE
  /// Surface non agricole (mare, bosquet, haie…).
  SNA
  /// Zone de densité homogène.
  ZDH
  /// Reçue mais non reconnue : conservée telle quelle plutôt qu'écartée.
  AUTRE
}

enum PacImportStatus {
  /// Fichiers analysés, aperçu disponible, rien n'est encore écrit.
  ANALYZED
  /// Import appliqué aux parcelles.
  APPLIED
  /// Analyse échouée, ou import abandonné par l'utilisateur.
  FAILED
  CANCELLED
}

/// Campagne PAC suivie pour une exploitation.
model PacCampaign {
  id     String @id @default(cuid())
  farmId String @map("farm_id")
  year   Int

  /// Version du référentiel de codes culture employée pour cette campagne.
  referentialVersion String?   @map("referential_version")
  lastImportAt       DateTime? @map("last_import_at")
  lastExportAt       DateTime? @map("last_export_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm      Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ilots     PacIlot[]
  features  PacFeature[]
  imports   PacImport[]
  snapshots PacSnapshot[]
  changes   PacChange[]

  @@unique([farmId, year])
  @@index([farmId])
  @@map("pac_campaigns")
}

/// Îlot PAC : un regroupement de parcelles, distinct de la parcelle elle-même.
model PacIlot {
  id         String                                       @id @default(cuid())
  campaignId String                                       @map("campaign_id")
  /// Numéro d'îlot tel qu'il figure dans le dossier.
  numero     String
  geom       Unsupported("geometry(MultiPolygon, 4326)")?
  areaHa     Decimal?                                     @map("area_ha") @db.Decimal(12, 4)
  attributes Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign PacCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  features PacFeature[]

  @@unique([campaignId, numero])
  @@map("pac_ilots")
}

/// Entité géographique importée : parcelle, SNA ou ZDH.
///
/// Une entité `PARCELLE` est rattachée à une parcelle Parcelys (`parcelId`) dès
/// qu'elle est rapprochée ; c'est cette parcelle-là qui porte les cultures, les
/// apports et les registres. Les SNA et ZDH n'ont pas d'équivalent dans le
/// modèle agricole : elles restent ici, et servent au contrôle et à l'export.
model PacFeature {
  id         String         @id @default(cuid())
  campaignId String         @map("campaign_id")
  ilotId     String?        @map("ilot_id")
  parcelId   String?        @map("parcel_id")
  kind       PacFeatureKind @default(PARCELLE)

  /// Identifiant porté par le fichier d'origine, quand il en porte un.
  externalId String? @map("external_id")
  /// Numéro de parcelle dans son îlot, tel que déclaré.
  numero     String?
  cropCode   String? @map("crop_code")
  cropLabel  String? @map("crop_label")

  geom   Unsupported("geometry(MultiPolygon, 4326)")?
  areaHa Decimal?                                     @map("area_ha") @db.Decimal(12, 4)

  /// Géométrie d'origine, conservée telle qu'importée, dans son système de
  /// coordonnées d'origine. Reprojeter en 4326 pour l'affichage puis revenir en
  /// Lambert-93 à l'export ferait un aller-retour inutile : pour une entité non
  /// modifiée, on réexporte exactement ce qui a été reçu.
  sourceWkt  String? @map("source_wkt")
  sourceSrid Int?    @map("source_srid")

  /// Attributs du fichier, conservés intégralement. Le module ne prétend pas
  /// connaître la signification de chacun : ce qui n'est pas reconnu est gardé
  /// plutôt qu'écarté.
  attributes Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign PacCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ilot     PacIlot?    @relation(fields: [ilotId], references: [id], onDelete: SetNull)
  parcel   Parcel?     @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  changes  PacChange[]

  @@index([campaignId, kind])
  @@index([parcelId])
  @@map("pac_features")
}

/// Un import : ce qui a été déposé, ce qui en a été compris, ce qui a été fait.
model PacImport {
  id         String          @id @default(cuid())
  campaignId String          @map("campaign_id")
  status     PacImportStatus @default(ANALYZED)

  /// Noms des fichiers déposés, pour que l'utilisateur retrouve ce qu'il a fait.
  sourceFiles  Json?   @map("source_files")
  detectedSrid Int?    @map("detected_srid")
  srcLabel     String? @map("src_label")

  featureCount Int      @default(0) @map("feature_count")
  ilotCount    Int      @default(0) @map("ilot_count")
  areaHa       Decimal? @map("area_ha") @db.Decimal(12, 4)

  /// Rapport d'analyse : anomalies, rapprochements proposés, décisions prises.
  report Json?

  snapshotId  String?   @map("snapshot_id")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  appliedAt   DateTime? @map("applied_at")

  campaign  PacCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  snapshot  PacSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@map("pac_imports")
}

/// Sauvegarde de l'état des parcelles avant un import.
///
/// Un import PAC touche au parcellaire : on garde de quoi revenir en arrière
/// avant d'y toucher, pas après avoir constaté les dégâts.
model PacSnapshot {
  id         String @id @default(cuid())
  campaignId String @map("campaign_id")
  label      String

  parcelCount Int      @default(0) @map("parcel_count")
  areaHa      Decimal? @map("area_ha") @db.Decimal(12, 4)
  /// État complet des parcelles et de leurs géométries, en GeoJSON.
  payload     Json

  restoredAt  DateTime? @map("restored_at")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  campaign  PacCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  imports   PacImport[]

  @@index([campaignId, createdAt])
  @@map("pac_snapshots")
}

/// Ce qui a changé depuis l'import PAC, et par qui.
model PacChange {
  id         String  @id @default(cuid())
  campaignId String  @map("campaign_id")
  featureId  String? @map("feature_id")
  parcelId   String? @map("parcel_id")
  userId     String? @map("user_id")

  /// `geometry`, `area`, `crop`, `create`, `delete`…
  changeType String @map("change_type")

  previousGeojson Json?    @map("previous_geojson")
  newGeojson      Json?    @map("new_geojson")
  previousAreaHa  Decimal? @map("previous_area_ha") @db.Decimal(12, 4)
  newAreaHa       Decimal? @map("new_area_ha") @db.Decimal(12, 4)
  previousCrop    String?  @map("previous_crop")
  newCrop         String?  @map("new_crop")

  createdAt DateTime @default(now()) @map("created_at")

  campaign PacCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  feature  PacFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  parcel   Parcel?     @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([parcelId])
  @@map("pac_changes")
}

/// Référentiel des codes culture PAC, par campagne et par version.
///
/// Les codes évoluent d'une campagne à l'autre : ils ne sont donc ni codés dans
/// l'interface, ni supposés stables. Chaque entrée porte sa campagne, sa version
/// de référentiel et sa provenance — et l'interface affiche cette provenance,
/// comme pour le catalogue phytosanitaire.
model PacCropCode {
  id         String  @id @default(cuid())
  year       Int
  code       String
  label      String
  groupCode  String? @map("group_code")
  groupLabel String? @map("group_label")
  /// Version du référentiel : deux versions d'une même campagne coexistent.
  version    String
  /// D'où vient cette entrée. Jamais « inventé ».
  source     String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([year, version, code])
  @@index([year, code])
  @@map("pac_crop_codes")
}
