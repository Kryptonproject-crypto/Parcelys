# ---------------------------------------------------------------------------
# Parcelys — configuration
# Copiez ce fichier en « .env » et renseignez vos valeurs.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Base de données PostgreSQL avec l'extension PostGIS activée.
# Avec Docker Compose : postgresql://parcelys:parcelys@localhost:5432/parcelys?schema=public
DATABASE_URL="postgresql://parcelys:parcelys@localhost:5432/parcelys?schema=public"

# URL publique de l'application (liens dans les e-mails, contrôle d'origine CSRF).
# En production, l'adresse exacte servie par le reverse proxy, en HTTPS :
#   APP_URL="https://parcelys.fr"
# Elle doit correspondre au certificat, sinon les liens des e-mails pointeront
# ailleurs et le contrôle d'origine CSRF rejettera les requêtes du navigateur.
APP_URL="http://localhost:3000"
APP_NAME="Parcelys"

# ---------------------------------------------------------------------------
# Sessions et mots de passe
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME="parcelys_session"
# Durée de vie maximale d'une session, en heures (336 h = 14 jours).
SESSION_TTL_HOURS=336
# Déconnexion après cette durée d'inactivité, en heures (168 h = 7 jours).
SESSION_IDLE_TIMEOUT_HOURS=168
# Coût bcrypt (10 à 15). Argon2id est utilisé automatiquement si le paquet
# optionnel @node-rs/argon2 s'installe sur la plateforme.
# Sur Raspberry Pi, 11 offre un bon compromis entre sécurité et temps de réponse.
PASSWORD_HASH_COST=12

# ---------------------------------------------------------------------------
# Envoi d'e-mails (vérification d'adresse, réinitialisation, notifications)
# console : affiche le message dans les logs — parfait en développement.
# smtp    : serveur SMTP classique (nodemailer).
# resend  : service transactionnel Resend (API HTTP).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="Parcelys <no-reply@parcelys.fr>"

# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=

# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Météo
# open-meteo      : service public, aucune clé requise (par défaut).
# openweathermap  : nécessite WEATHER_API_KEY.
# ---------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo
# WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Cartographie
# Fond de plan compatible XYZ. OpenStreetMap par défaut ; pensez à respecter
# la politique d'usage du fournisseur choisi en production.
# ---------------------------------------------------------------------------
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="&copy; contributeurs <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
# MAP_API_KEY=

# Géocodage : Base Adresse Nationale (service public français, sans clé).
GEOCODER_URL="https://api-adresse.data.gouv.fr/search/"

# ---------------------------------------------------------------------------
# Référentiel phytosanitaire E-Phy
#
# Parcelys ne génère AUCUNE donnée réglementaire. Pour activer la recherche de
# produits, indiquez l'URL de l'archive ZIP du jeu de données officiel
# « E-Phy : catalogue des produits phytopharmaceutiques » publié par l'ANSES
# sur data.gouv.fr, puis lancez :  npm run ephy:sync
#
# Sans cette variable, la recherche de produits reste vide et l'interface
# l'indique explicitement.
# ---------------------------------------------------------------------------
# EPHY_DATA_URL="https://.../ephy.zip"
EPHY_DATA_DIR="./data/ephy"

# ---------------------------------------------------------------------------
# Documents joints aux parcelles
# ---------------------------------------------------------------------------
UPLOAD_DIR="./storage/documents"
# Taille maximale par fichier, en octets (15 Mo).
UPLOAD_MAX_BYTES=15728640

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Application mobile (Capacitor)
#
# Origines autorisées à appeler l'API depuis l'APK. Une WebView Capacitor sert
# ses fichiers depuis « http://localhost » (Android) ou « capacitor://localhost »
# (iOS) : ce sont d'autres origines que celle du serveur, elles doivent donc
# être déclarées ici. La valeur par défaut couvre les cas courants ; ne
# l'étendez qu'à un « androidScheme » personnalisé, jamais à un domaine web.
#
# L'application native s'authentifie par jeton « Authorization: Bearer » et non
# par cookie : aucune session de navigateur ne peut être empruntée depuis ces
# origines.
# ---------------------------------------------------------------------------
# MOBILE_APP_ORIGINS="capacitor://localhost,http://localhost,https://localhost,ionic://localhost"

# ---------------------------------------------------------------------------
# Inscriptions et administration
#
# L'inscription publique est fermée : créer un compte exige un code délivré par
# un administrateur (onglet « Administration », ou « npm run admin -- inviter »).
# Aucune variable d'environnement ne l'ouvre — c'est une règle applicative, pas
# un réglage. Le tout premier compte d'une base vide fait exception : il
# s'inscrit sans code et devient administrateur de l'instance.
#
# Rétablir un accès administrateur depuis le serveur :
#   npm run admin -- promouvoir votre@adresse.fr
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Mises à jour
#
# Dépôt GitHub surveillé, sous la forme « proprietaire/depot ». La section
# « Administration → Maintenance » y regarde une fois par heure si une version
# plus récente a été publiée, et l'application de terrain propose l'APK joint
# à cette publication.
#
# Parcelys n'installe JAMAIS rien tout seul : la mise à jour reste une
# opération faite par l'exploitant, sauvegarde faite. Sans cette variable,
# aucune requête ne sort de l'instance.
# ---------------------------------------------------------------------------
# UPDATE_REPOSITORY="kryptonproject-crypto/parcelys"

# ---------------------------------------------------------------------------
# Données de démonstration (npm run db:seed)
# Le compte semé est administrateur de l'instance : c'est lui qui délivre les
# premiers codes d'invitation.
# ---------------------------------------------------------------------------
DEMO_SEED_EMAIL="demo@parcelys.local"
DEMO_SEED_PASSWORD="Demo1234!"

# ---------------------------------------------------------------------------
# Tests — base dédiée, vidée à chaque exécution.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL="postgresql://parcelys:parcelys@localhost:5432/parcelys_test?schema=public"
