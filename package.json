{
  "name": "parcelys",
  "version": "0.9.0",
  "private": true,
  "description": "Parcelys — logiciel de gestion parcellaire agricole (SaaS)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/assemble-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "preflight": "node scripts/preflight.mjs",
    "start:next": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "ephy:sync": "tsx --conditions=react-server scripts/ephy-sync.ts",
    "postinstall": "prisma generate",
    "maintenance": "tsx scripts/maintenance.ts",
    "admin": "tsx --conditions=react-server scripts/admin.ts",
    "reset:data": "tsx --conditions=react-server scripts/reset-data.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "exports:preview": "tsx --conditions=react-server scripts/preview-exports.ts",
    "test:ci": "npm run build && vitest run",
    "check:security": "node scripts/check-security.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:advisory": "node scripts/check-advisory-flow.mjs",
    "check:mobile": "node scripts/check-mobile-layout.mjs",
    "check:admin": "node scripts/check-admin-v3.mjs",
    "email:test": "tsx --conditions=react-server scripts/email-test.ts",
    "check:corrections": "node scripts/check-corrections.mjs",
    "check:stocks": "tsx --conditions=react-server scripts/check-stocks.ts",
    "check:couverture": "tsx --conditions=react-server scripts/check-couverture.ts",
    "check:plafond": "tsx --conditions=react-server scripts/check-plafond.ts",
    "check:dossier": "tsx --conditions=react-server scripts/check-dossier.ts",
    "check:carte": "tsx --conditions=react-server scripts/check-carte.ts",
    "check:ecrans": "node scripts/check-ecrans-07.mjs",
    "audit:comptes": "tsx --conditions=react-server scripts/audit-accounts.ts",
    "audit": "npm run audit:comptes && node scripts/audit-pages.mjs",
    "verif:sans-navigateur": "npm run check:stocks && npm run check:couverture && npm run check:plafond && npm run check:dossier && npm run check:carte",
    "audit:debit": "tsx --conditions=react-server scripts/audit-reset-debit.ts",
    "verif:navigateur": "npm run audit:debit && npm run audit:comptes && npm run check:ecrans && npm run audit:debit && npm run check:pages && npm run audit:debit && npm run check:mobile && npm run audit:debit && npm run check:modales && npm run audit:debit && npm run check:corrections && npm run audit:debit && npm run check:admin && npm run audit:debit && npm run check:advisory && npm run audit:debit && npm run check:security",
    "referentiels": "tsx --conditions=react-server scripts/referentiels.ts",
    "check:telepac": "tsx --conditions=react-server scripts/check-telepac-xml.ts",
    "check:pac": "tsx --conditions=react-server scripts/check-pac-import.ts",
    "check:modales": "node scripts/check-modales.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/geojson": "^7946.0.16",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.42.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.16.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "shapefile": "^0.6.6",
    "unzipper": "^0.12.3",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/shapefile": "^0.6.4",
    "@types/unzipper": "^0.10.11",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "postcss": "^8.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
